# Karigar AI — environment variables
# Copy this file to .env.local and fill in keys to enable live AI features.
# If left blank, the app automatically runs in polished Demo/Fallback Mode
# using realistic sample outputs, so it stays fully demonstrable offline.

# Optional: Anthropic API key for vision analysis + listing/marketing generation.
# NOTE: In a real deployment this call must be proxied through a backend/server
# route — never ship a secret key inside frontend JS. This project's client-side
# service checks for a key only to demonstrate the integration point; wire it to
# your own backend endpoint before shipping to production.
VITE_AI_API_ENABLED=false
